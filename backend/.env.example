# Groq API Key (Primary LLM Provider)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini API Key (Automatic Rate-Limit Backup Provider)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# CORS Allowed Origins (Comma-separated, or set ALLOW_ALL_ORIGINS=true)
ALLOWED_ORIGINS=http://localhost:5173,https://personal-chat-bot-psi.vercel.app
ALLOW_ALL_ORIGINS=false

